# Aquario STV-3000 — Android 9 / Amlogic GXL
#
# O kernel Amlogic cria os dispositivos abaixo conforme sua tabela
# proprietária de partições.

/dev/block/cache    /cache    ext4  noatime,nosuid,nodev,nomblk_io_submit,errors=panic      wait,nofail
/dev/block/data     /data     ext4  noatime,nosuid,nodev,nomblk_io_submit,errors=panic      wait,nofail
/dev/block/tee      /tee      ext4  noatime,nosuid,nodev                                   wait,nofail

/devices/*.sd/mmc_host/sd*                                     auto  auto  defaults  voldmanaged=sdcard1:auto,noemulatedsd
/devices/*dwc3/xhci-hcd.0.auto/usb?/*/host*/target*/block/sd*  auto  auto  defaults  voldmanaged=udisk:auto
/devices/*dwc3/xhci-hcd.0.auto/usb?/*/host*/target*/block/sr*  auto  auto  defaults  voldmanaged=sr0:auto
