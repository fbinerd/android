# OpenWrt-style Package Definition for SmartTube Next

PKG_NAME:=smarttube
PKG_VERSION:=latest
PKG_RELEASE:=1
PKG_DESCRIPTION:=SmartTube Next (YouTube sem anúncios com suporte a 4K)

define Package/smarttube
  SECTION:=apps
  CATEGORY:=Applications
  TITLE:=SmartTube Next Player
  DEFAULT:=y
endef

$(eval $(call BuildPackage,smarttube))
