# Build & Cache Directories
workspace/
out/
tmp/
work/
logs/
*.log

# Allow prebuilt partition images in device profiles
!devices/**/prebuilts/*.img
!devices/**/prebuilts/*.dtb

# Python & Compiled Cache
__pycache__/
*.pyc
*.pyo

# Docker runtime state
.docker/
.env

# Temporary artifacts
*.tmp
*.bak
*.swp

# OS Files
.DS_Store
Thumbs.db
