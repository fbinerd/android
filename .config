CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_s905w=y
CONFIG_TARGET_amlogic_s905w_aquario_stv3000=y
CONFIG_BOARD_NAME="Aquário STV3000"

# Storage & Layout Presets
CONFIG_FLASH_SIZE="32g"
CONFIG_STORAGE_MEDIUM="sdcard"
