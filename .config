CONFIG_DISABLE_PICDEC=y

# Packages & Applications
CONFIG_PACKAGE_smarttube=y
CONFIG_PACKAGE_aurora_store=y
CONFIG_PACKAGE_vlc=y
CONFIG_PACKAGE_globoplay=y

# Services & Daemons
CONFIG_SERVICE_FORCE_STOP_BOOT=y
CONFIG_SERVICE_RAM_MONITOR=y
CONFIG_SELINUX_AUDIT_ZERO=y
