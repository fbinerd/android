 static DEFINE_MUTEX(setclk_mutex);
@@ -583,6 +584,21 @@ static int set_disp_mode_auto(void)
 	else {
 	/* nothing */
 	}
+	/*
+	 * Keep the U-Boot link alive until the first Android frame replaces
+	 * its logo. SystemControl briefly requests its EDID-preferred mode
+	 * before applying the configured UI mode, which otherwise resets TMDS.
+	 */
+	if (get_logo_loaded() && (vic_ready != HDMI_Unknown)) {
+		pr_info(SYS
+			"preserve board U-Boot VIC 16 while logo is active; hw VIC %d, defer VIC %d\n",
+			vic_ready, vic);
+		hdev->cur_VIC = HDMI_1080p60;
+		hdev->output_blank_flag = 1;
+		hdev->ready = 1;
+		edidinfo_attach_to_vinfo(hdev);
+		return 1;
+	}
