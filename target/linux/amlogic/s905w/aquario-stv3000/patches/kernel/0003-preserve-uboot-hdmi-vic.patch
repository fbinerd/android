 		pr_info(SYS "[%s] ALREADY init VIC = %d\n",
 			__func__, vic);
@@ -4732,7 +4748,9 @@ static int hdmitx_set_current_vmode(enum vmode_e mode)
 		recalc_vinfo_sync_duration(vinfo,
 			hdmitx_device.frac_rate_policy);
 
